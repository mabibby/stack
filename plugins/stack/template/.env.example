# Copy to .env.local for local development (bun run setup does this for you).
# Never commit .env.local. Every variable here is validated in src/lib/env.ts —
# add new ones there too, or the app refuses to boot.

APP_URL=http://localhost:3000
DATABASE_URL=postgres://__DB_NAME__:__DB_NAME__@localhost:5432/__DB_NAME__

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Email. Local: Mailpit SMTP (view at http://localhost:8025). Prod: set RESEND_API_KEY instead.
EMAIL_FROM="__APP_TITLE__ <hello@example.com>"
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=

# Object storage. Local: MinIO (console http://localhost:9001). Prod: Railway bucket / R2 / S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=__APP_NAME__
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
