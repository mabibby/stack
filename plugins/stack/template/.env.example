# Copy to .env.local for local development (bun run setup does this for you).
# Never commit .env.local. Every variable here is validated in src/lib/env.ts —
# add new ones there too, or the app refuses to boot.

APP_URL=http://localhost:__PORT_WEB__
DATABASE_URL=postgres://__DB_NAME__:__DB_NAME__@localhost:__PORT_PG__/__DB_NAME__

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Email. Local: Mailpit SMTP (view at http://localhost:__PORT_MAIL__). Prod: set RESEND_API_KEY instead.
EMAIL_FROM="__APP_TITLE__ <hello@example.com>"
SMTP_URL=smtp://localhost:__PORT_SMTP__
# RESEND_API_KEY=

# Object storage. Local: RustFS (console http://localhost:__PORT_S3_CONSOLE__/rustfs/console/). Prod: Railway bucket / R2 / S3.
S3_ENDPOINT=http://localhost:__PORT_S3__
S3_REGION=us-east-1
S3_BUCKET=__APP_NAME__
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=rustfs-secret
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug

# Who may create an account. Empty = anyone (keep it empty locally so tests can sign up).
# Production: comma-separated emails and/or @domains, e.g. "you@example.com,@yourcompany.com".
SIGNUP_ALLOWLIST=
