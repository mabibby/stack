{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bun run scripts/setup/dev.ts",
    "dev": "next dev",
    "dev:worker": "bun --watch worker/index.ts",
    "build": "next build",
    "start": "next start",
    "worker": "bun worker/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "auth:schema": "JITI_CACHE=false bunx auth@latest generate --config src/lib/auth/auth.ts --output src/lib/db/schema/auth.ts -y && biome check --write src/lib/db/schema/auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@hookform/resolvers": "^5.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "@biomejs/biome"
  ]
}
