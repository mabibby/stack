{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/bun.lock",
      "!**/drizzle/**/*.sql",
      "!**/drizzle/meta",
      "!**/src/components/ui",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": { "next": "recommended", "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noUselessStringConcat": "error",
        "useSimplifiedLogicExpression": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "noNegationElse": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useConst": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error", "info"] } },
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "useAwait": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": { "functions": ["clsx", "cva", "cn", "twMerge"] }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": { "formatter": { "indentStyle": "space", "indentWidth": 2 } },
  "css": {
    "parser": { "cssModules": true, "tailwindDirectives": true },
    "formatter": { "indentStyle": "space", "indentWidth": 2 }
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.{ts,js,mjs,mts}",
        "**/scripts/**",
        "**/worker/**",
        "**/src/lib/jobs/**"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off", "useAwait": "off" } } }
    }
  ]
}
